    "That password doesn't open this backup. Try again — capitals count." : {
      "localizations" : {
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto heslo zálohu neotvorí. Skús znova — na veľkých písmenách záleží."
          }
        }
      }
    },
    "That's fine — reminders will show inside tikjot. You can allow them later in System Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "sk" : {
