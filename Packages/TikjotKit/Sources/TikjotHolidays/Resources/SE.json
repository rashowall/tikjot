    { "id": "epiphany",       "rule": { "fixed": "01-06" }, "name": { "en": "Epiphany", "sk": "Zjavenie Pána (Traja králi)", "sv": "Trettondedag jul" } },
    { "id": "good-friday",    "rule": { "easter": -2 },     "name": { "en": "Good Friday", "sk": "Veľký piatok", "sv": "Långfredagen" } },
