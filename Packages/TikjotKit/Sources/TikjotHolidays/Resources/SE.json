    { "id": "labour-day",     "rule": { "fixed": "05-01" }, "name": { "en": "May Day", "sk": "Sviatok práce", "sv": "Första maj" } },
    { "id": "ascension",      "rule": { "easter": 39 },     "name": { "en": "Ascension Day", "sk": "Nanebovstúpenie Pána", "sv": "Kristi himmelsfärdsdag" } },
    { "id": "whit-monday",    "rule": { "easter": 50 }, "validTo": 2004, "name": { "en": "Whit Monday", "sk": "Svätodušný pondelok", "sv": "Annandag pingst" } },
    { "id": "national-day",   "rule": { "fixed": "06-06" }, "validFrom": 2005, "name": { "en": "National Day of Sweden", "sk": "Švédsky štátny sviatok", "sv": "Sveriges nationaldag" } },
