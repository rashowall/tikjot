    { "id": "good-friday",     "rule": { "easter": -2 },     "name": { "en": "Good Friday", "sk": "Veľký piatok" } },
    { "id": "easter-monday",   "rule": { "easter": 1 },      "name": { "en": "Easter Monday", "sk": "Veľkonočný pondelok" } },
    { "id": "labour-day",      "rule": { "fixed": "05-01" }, "name": { "en": "Labour Day", "sk": "Sviatok práce" } },
