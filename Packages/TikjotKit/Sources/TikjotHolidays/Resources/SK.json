    { "id": "cyril-methodius", "rule": { "fixed": "07-05" }, "name": { "en": "St. Cyril and Methodius Day", "sk": "Sviatok svätého Cyrila a svätého Metoda" } },
    { "id": "snp",             "rule": { "fixed": "08-29" }, "name": { "en": "Slovak National Uprising Anniversary", "sk": "Výročie Slovenského národného povstania" } },
