    { "id": "all-saints",     "rule": { "fixed": "11-01" }, "exceptYears": [2013, 2014, 2015], "name": { "en": "All Saints' Day", "sk": "Sviatok Všetkých svätých", "pt": "Dia de Todos-os-Santos" } },
    { "id": "restoration",    "rule": { "fixed": "12-01" }, "exceptYears": [2013, 2014, 2015], "name": { "en": "Restoration of Independence", "sk": "Deň obnovenia nezávislosti", "pt": "Restauração da Independência" } },
    { "id": "immaculate",     "rule": { "fixed": "12-08" }, "name": { "en": "Immaculate Conception", "sk": "Nepoškvrnené počatie Panny Márie", "pt": "Imaculada Conceição" } },
